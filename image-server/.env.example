# ============================================================
#  Xeko Image Server – chạy trên VPS phụ chuyên lưu ảnh history.
# ============================================================

# Port HTTP. Mặc định 4001.
PORT=4001

# API key bảo mật giữa server chính (ai.basso.vn) và image server.
# Server chính phải gửi header x-api-key khớp với giá trị này khi POST /upload.
# Phải giống IMAGE_SERVER_API_KEY trên server chính.
API_KEY=change-this-image-server-secret

# URL public của image server (dùng để build URL trả về trong response /upload).
# Ví dụ: https://img.basso.vn  hoặc  http://180.x.x.x:4001
# Nếu để trống, response trả URL relative (/img/...).
PUBLIC_URL=

# Thư mục lưu ảnh. Mặc định ./data/uploads (giống server chính).
# Nên trỏ vào persistent volume để không mất khi redeploy.
UPLOADS_DIR=./data/uploads
