# ============================================================
#  Xeko – Local Server (.env)
#  Chỉ chứa biến mà máy local thực sự dùng.
# ============================================================

# API Key bảo mật giữa ai.basso.vn và máy local.
# BẮT BUỘC đặt key dài random — server sẽ refuse khởi động nếu để trống
# hoặc còn là 'change-this-secret-key'.
# Tạo bằng:  openssl rand -hex 32     (hoặc 32 ký tự bất kỳ)
# Phải khớp với LOCAL_API_KEY trên server ai.basso.vn.
LOCAL_API_KEY=

# Rate limit cho /api/post, /api/fb-quick-post-test, /api/zalo/post.
# Tránh spam đẩy FB/Zalo flag. Để trống = dùng default.
# POST_MIN_INTERVAL_MS=30000   # tối thiểu 30s giữa 2 post cùng profile (FB)
# POST_HOURLY_LIMIT=40         # tối đa 40 post/giờ/profile (tăng để nhân viên đăng nhiều hơn)
# ZALO_POST_MIN_INTERVAL_MS=30000  # (cũ) fallback cho POST_GROUP_DELAY_MIN_MS

# ----- Khoảng cách (delay) giữa các bài đăng — chống FB/Zalo flag spam -----
# Áp dụng cho CẢ FB và Zalo, CẢ đăng ngay lẫn đăng theo lịch.
# Mỗi lần lấy 1 giá trị NGẪU NHIÊN trong khoảng [min, max] (giống người thật).
#
# (1) GROUP — giữa 2 bài CÙNG 1 profile/account (đăng lần lượt các kênh/group):
# POST_GROUP_DELAY_MIN_MS=30000    # mặc định 30s (fallback ZALO_POST_MIN_INTERVAL_MS / POST_MIN_INTERVAL_MS)
# POST_GROUP_DELAY_MAX_MS=60000    # mặc định 60s
#
# (2) PROFILE — lệch thời điểm BẮT ĐẦU giữa 2 profile/account KHÁC nhau khi
#     cùng đăng (để không "nổ đồng loạt cùng một giây"). Hiện áp dụng cho Zalo:
# POST_PROFILE_DELAY_MIN_MS=15000  # mặc định 15s
# POST_PROFILE_DELAY_MAX_MS=30000  # mặc định 30s
#   (Để min = max nếu muốn delay cố định; ví dụ đặt cả 2 = 30000 để cố định 30s.)

# ----- Tái dùng phiên browser ZaloCRM (đăng nhiều group cùng account) -----
# Cùng 1 account đăng liên tiếp nhiều group thì GIỮ browser đã ấm (đã login + chọn
# account) thay vì đóng/mở lại mỗi bài → bài sau ổn định hơn, ít vấp cold-load.
# Rảnh (không có bài mới) quá ngần này thì tự đóng phiên để trả RAM.
# Mặc định = POST_GROUP_DELAY_MAX_MS + 30s (đủ sống qua khoảng chờ giữa 2 bài).
# ZALO_SESSION_IDLE_MS=90000

# Auto-retry: khi bài FB bị chặn vì chạm hourly limit, tự hẹn đăng lại thay vì Failed.
# POST_RETRY_MAX=5             # số lần tự đăng lại tối đa trước khi bỏ cuộc (default 5)
# POST_RETRY_BUFFER_MS=15000   # đệm thêm sau cửa sổ rate-limit cho chắc (default 15s)

# Port HTTP cho local server (Express). Mặc định 3001.
LOCAL_PORT=3001

# API Key của Google Gemini AI (dùng cho tính năng gợi ý content từ ảnh).
# Lấy tại: https://aistudio.google.com/app/apikey
# Để trống nếu không dùng tính năng AI.
GEMINI_API_KEY=

# (Tuỳ chọn) URL của remote bot trên ai.basso.vn.
# Chỉ cần khi chạy bằng start.js + Cloudflare Tunnel để tự đăng ký URL tunnel.
# Nếu cấu hình PLAYWRIGHT_LOCAL_URL bằng IP trực tiếp ở admin panel
# thì có thể để trống / bỏ qua.
REMOTE_BOT_URL=https://ai.basso.vn/b/your-bot-id

# URL của máy local có Chromium đã cài (server/local-server.js đang chạy).
# Bot remote sẽ forward mọi thao tác Playwright (mở trình duyệt, đăng nhập,
# đăng bài, kiểm tra session...) tới URL này thay vì chạy trực tiếp.
# Bắt buộc cấu hình trên bot remote nếu máy chạy bot KHÔNG có Chromium.
# Ví dụ: http://180.93.36.109:3001 (IP public + LOCAL_PORT của máy local).
# Để trống nếu chạy Playwright trực tiếp trên cùng máy với bot.
PLAYWRIGHT_LOCAL_URL=

# (Tuỳ chọn) URL của image server chạy trên VPS phụ chuyên lưu ảnh history.
# Khi set, mọi ảnh upload sẽ được forward qua endpoint POST /upload của VPS
# này, URL trả về (vd https://img.basso.vn/img/2026-05-12/abc.jpg) sẽ lưu
# trong history DB. Nếu upload fail / để trống → fallback lưu local
# data/uploads/ (route /api/image/* cũ vẫn hoạt động cho ảnh history cũ).
IMAGE_SERVER_URL=

# API key gửi qua header x-api-key tới image server. Phải khớp với API_KEY
# trong file .env của image-server/. Bắt buộc khi đã set IMAGE_SERVER_URL.
IMAGE_SERVER_API_KEY=change-this-image-server-secret

# Bật khi VPS phụ KHÔNG expose HTTP ra internet (ví dụ chỉ có SSH, image server
# bind 127.0.0.1 và kết nối qua SSH tunnel: ssh -L 4001:127.0.0.1:4001 vps-phu).
# Khi true:
#   - URL trong history sẽ là /api/image/YYYY-MM-DD/file (relative, qua VPS chính)
#   - Route /api/image/* trên VPS chính sẽ stream ảnh từ image server xuống browser
# Khi false/để trống: URL trong history là URL trực tiếp từ image server
# (cần PUBLIC_URL trên image-server và port HTTP/HTTPS mở public).
IMAGE_SERVER_PROXY_MODE=false

# (Tuỳ chọn) TỰ ĐỘNG ĐĂNG NHẬP LẠI ZaloCRM (zalo.basso.vn) khi session hết hạn.
# Session ZaloCRM hết hạn sau ~7 ngày → trình duyệt bị đẩy về trang đăng nhập và
# việc đăng bài dừng cho tới khi admin đăng nhập tay. Đặt username/password ở đây
# để hệ thống TỰ điền form đăng nhập và tiếp tục đăng, khỏi phải mở tay mỗi tuần.
# Dùng chung cho MỌI tài khoản Zalo (1 CRM login quản nhiều Zalo). Có thể ghi đè
# riêng từng tài khoản bằng crmUsername/crmPassword trong config/zalo-accounts.json.
# Để trống → giữ hành vi cũ (báo admin đăng nhập tay khi session hết hạn).
BASSO_ZALO_USERNAME=
BASSO_ZALO_PASSWORD=
