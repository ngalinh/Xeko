# ============================================================
#  Xeko – Local Server (.env)
#  Chỉ chứa biến mà máy local thực sự dùng.
# ============================================================

# API Key bảo mật giữa ai.basso.vn và máy local.
# Phải khớp với LOCAL_API_KEY trên server ai.basso.vn.
LOCAL_API_KEY=change-this-secret-key

# Port HTTP cho local server (Express). Mặc định 3001.
LOCAL_PORT=3001

# (Tuỳ chọn) URL của remote bot trên ai.basso.vn.
# Chỉ cần khi chạy bằng start.js + Cloudflare Tunnel để tự đăng ký URL tunnel.
# Nếu cấu hình PLAYWRIGHT_LOCAL_URL bằng IP trực tiếp ở admin panel
# thì có thể để trống / bỏ qua.
REMOTE_BOT_URL=https://ai.basso.vn/b/your-bot-id

# URL của máy local có Chromium đã cài (server/local-server.js đang chạy).
# Bot remote sẽ forward mọi thao tác Playwright (mở trình duyệt, đăng nhập,
# đăng bài, kiểm tra session...) tới URL này thay vì chạy trực tiếp.
# Bắt buộc cấu hình trên bot remote nếu máy chạy bot KHÔNG có Chromium.
# Ví dụ: http://180.93.36.109:3001 (IP public + LOCAL_PORT của máy local).
# Để trống nếu chạy Playwright trực tiếp trên cùng máy với bot.
PLAYWRIGHT_LOCAL_URL=

# (Tuỳ chọn) URL của image server chạy trên VPS phụ chuyên lưu ảnh history.
# Khi set, mọi ảnh upload sẽ được forward qua endpoint POST /upload của VPS
# này, URL trả về (vd https://img.basso.vn/img/2026-05-12/abc.jpg) sẽ lưu
# trong history DB. Nếu upload fail / để trống → fallback lưu local
# data/uploads/ (route /api/image/* cũ vẫn hoạt động cho ảnh history cũ).
IMAGE_SERVER_URL=

# API key gửi qua header x-api-key tới image server. Phải khớp với API_KEY
# trong file .env của image-server/. Bắt buộc khi đã set IMAGE_SERVER_URL.
IMAGE_SERVER_API_KEY=change-this-image-server-secret

# Bật khi VPS phụ KHÔNG expose HTTP ra internet (ví dụ chỉ có SSH, image server
# bind 127.0.0.1 và kết nối qua SSH tunnel: ssh -L 4001:127.0.0.1:4001 vps-phu).
# Khi true:
#   - URL trong history sẽ là /api/image/YYYY-MM-DD/file (relative, qua VPS chính)
#   - Route /api/image/* trên VPS chính sẽ stream ảnh từ image server xuống browser
# Khi false/để trống: URL trong history là URL trực tiếp từ image server
# (cần PUBLIC_URL trên image-server và port HTTP/HTTPS mở public).
IMAGE_SERVER_PROXY_MODE=false
